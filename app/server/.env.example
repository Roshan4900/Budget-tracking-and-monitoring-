# ------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to git (see .gitignore).
# ------------------------------------------------------------

# Port the server listens on
PORT=3000

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid
TOKEN_EXPIRY=8h

# Set to "true" only when serving over HTTPS in production
# (makes the login cookie HTTPS-only).
SECURE_COOKIES=false

# Used ONLY by `npm run create-admin` to create the first admin account.
# After the admin is created you can blank these out.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!
